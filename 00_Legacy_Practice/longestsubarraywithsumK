#include <iostream>
using namespace std;

int longestSubarrayWithSumK(int arr[], int n, int K) {
    int start = 0, end = 0;
    int sum = 0, maxLen = 0;

    while (end < n) {
        sum += arr[end];

        while (sum > K && start <= end) {
            sum -= arr[start];
            start++;
        }

        if (sum == K)
            maxLen = max(maxLen, end - start + 1);

        end++;
    }

    return maxLen;
}

int main() {
    int arr[] = {1, 2, 1, 0, 1, 1, 0};
    int K = 4;
    int n = sizeof(arr) / sizeof(arr[0]);

    cout << "Longest subarray with sum " << K << " is of length: "
         << longestSubarrayWithSumK(arr, n, K) << endl;

    return 0;
}
